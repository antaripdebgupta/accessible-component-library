{
  "name": "@accessly-ui/primitives",
  "version": "1.0.1",
  "description": "Headless, unstyled, WCAG 2.2 AA accessible component logic for React",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "keywords": [
    "react",
    "headless-ui",
    "unstyled",
    "accessibility",
    "a11y",
    "wcag",
    "aria",
    "react-hooks",
    "keyboard-navigation",
    "focus-management"
  ],
  "author": "Antarip Debgupta",
  "license": "MIT",
  "dependencies": {
    "@accessly-ui/utils": "workspace:*"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "jsdom": "^29.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/antaripdebgupta/accessible-component-library.git",
    "directory": "packages/primitives"
  },
  "homepage": "https://github.com/antaripdebgupta/accessible-component-library#readme",
  "bugs": {
    "url": "https://github.com/antaripdebgupta/accessible-component-library/issues"
  }
}
