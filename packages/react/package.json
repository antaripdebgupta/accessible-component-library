{
  "name": "@accessly-ui/react",
  "version": "1.0.1",
  "description": "Styled, composable, WCAG 2.2 AA accessible React components built on @accessly-ui/primitives",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "keywords": [
    "react",
    "components",
    "ui-library",
    "design-system",
    "accessibility",
    "a11y",
    "wcag",
    "wcag-2.2",
    "aria",
    "tailwindcss",
    "headless-ui",
    "dialog",
    "combobox",
    "data-table"
  ],
  "author": "Antarip Debgupta",
  "license": "MIT",
  "dependencies": {
    "@accessly-ui/primitives": "workspace:*",
    "@accessly-ui/utils": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "lucide-react": "^1.26.0",
    "tailwind-merge": "^3.6.0"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@accessly-ui/tailwind-preset": "workspace:*",
    "@storybook/react": "^10.5.3",
    "@storybook/test": "^8.6.15",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest-axe": "^3.5.9",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "jest-axe": "^10.0.0",
    "jsdom": "^29.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/antaripdebgupta/accessible-component-library.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/antaripdebgupta/accessible-component-library#readme",
  "bugs": {
    "url": "https://github.com/antaripdebgupta/accessible-component-library/issues"
  }
}
